# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# raw screenshot drops for scripts/optimize-portfolio-images.mjs
/raw-screenshots/

# reference screenshots for the banner studios (src/app/[locale]/banner*)
/banner/

# Banner studios — local-only tooling for generating marketing/MVP banner art.
# They are real App Router segments, so committing them would publish
# /banner and /banner-mvp on the production site. Keep them untracked.
# (brackets escaped: an unescaped [locale] is a gitignore character class)
src/app/\[locale\]/banner/
src/app/\[locale\]/banner-mvp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.docker/.env
.env*

# vercel
.vercel

# scripts/validate-json-ld.mjs caches the 1.5 MB schema.org vocabulary here
/.cache/

# next-sitemap generated artifacts (regenerated each build)
/public/robots.txt
/public/sitemap.xml
/public/sitemap-*.xml

# typescript
*.tsbuildinfo
next-env.d.ts

.idea

/.playwright-mcp/

# Generated before the image build from git history (scripts/gen-sitemap-lastmod.cjs).
# Never committed: it is derived, and a stale copy would out-rank the real dates.
sitemap-lastmod.json
